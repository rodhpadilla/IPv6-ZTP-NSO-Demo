# Copy to config.env and fill in your own values
# Load with: set -a && source config.env && set +a

NSO_HOST=<nso-host>
NSO_USER=<nso-user>
NSO_PASS=<nso-pass>
NSO_AUTHGROUP=default

# If you wire up a real NetBox lookup in scripts/netbox.py:
# NETBOX_URL=https://netbox.example.net
# NETBOX_TOKEN=<your-netbox-token>
